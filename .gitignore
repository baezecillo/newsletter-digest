# --- Secrets / credentials: never commit these ---
credentials.json
token.json
.env

# --- Personal sender allowlist (use senders.txt.example as the template) ---
senders.txt

# --- Python ---
__pycache__/
*.pyc
*.pyo
venv/
.venv/
*.egg-info/
.mypy_cache/
.pytest_cache/

# --- Fetched data and generated digests (reveal senders / personal email
# --- content, regenerated by the script and skill) ---
fetched/
digests/

# --- Claude Code local/session state (the skill itself stays tracked) ---
.claude/settings.local.json
.claude/*.local.json

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Packaging output (rebuild on demand, don't version) ---
*.zip