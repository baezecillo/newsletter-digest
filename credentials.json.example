{
    "_instructions": "Copy this file to credentials.json (removing the .example suffix) and replace every value below with the contents of the OAuth client JSON downloaded from Google Cloud Console: APIs & Services > Credentials > OAuth client ID > Desktop app > Download JSON. cp credentials.json.example credentials.json",
    "installed": {
        "client_id": "YOUR_CLIENT_ID.apps.googleusercontent.com",
        "project_id": "your-project-id",
        "auth_uri": "https://accounts.google.com/o/oauth2/auth",
        "token_uri": "https://oauth2.googleapis.com/token",
        "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
        "client_secret": "YOUR_CLIENT_SECRET",
        "redirect_uris": [
            "http://localhost"
        ]
    }
}